# Public JSON feed; must allow CORS from browser/Capacitor origins.
VITE_QUESTIONS_URL=https://raw.githubusercontent.com/Sluchaino/AnswerBook/main/src/data/questions.json

# Public HTTPS content server catalog. Required for Android course updates.
# Local development uses /api/catalog; production defaults to content-host.json.
